print('IS A LETTER A VOWEL OR A CONSONANT')

# verify input
inp = input('Enter a single letter: ')
if len(inp) == 1 and inp.isalpha(): # is it a single letter?
    chr = inp.lower() # avoid letter case errors
elif len(inp) != 1:
    print('Error! enter a single letter.')
    quit()
else:
    print('Error! enter letters only')
    quit()

# processing
if chr in 'aeiou': # check if inp is a vowel
    print('That letter is a vowel')
else:
    print('That letter is a consonant')
