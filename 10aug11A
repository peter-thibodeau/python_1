print('CLASSIFY YOUR AGE')

# input verification
inp = input('Enter your age: ')
if inp.isdigit():
    age = int(inp)
else: # a non-numeric character including a dash before a number is an error
    print('Error! enter a positive number.')
    quit()

# processing: classify the age
if age < 18:
    print('minor')
elif 18 <= age <= 65:
    print('adult')
else:
    print('senior citizen')
